<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/boutonRetourQuiz"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#17152A"
            android:textSize="38sp"/>

        <TextView
            android:id="@+id/texteTitreQuizPassation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quiz"
            android:textColor="#17152A"
            android:textSize="19sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- === Contenu du quiz (questions) === -->
    <ScrollView
        android:id="@+id/scrollViewQuiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/texteProgressionQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question 1/1"
                android:textColor="#6534D9"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="18dp"
                android:background="@drawable/bg_carte">

                <TextView
                    android:id="@+id/texteQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Texte de la question"
                    android:textColor="#17152A"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <RadioGroup
                    android:id="@+id/groupeOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Navigation questions -->
    <LinearLayout
        android:id="@+id/barreNavigationQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/boutonPrecedent"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Précédent"
            android:textAllCaps="false"
            android:textColor="#6534D9"
            android:backgroundTint="#EDE7FF"/>

        <Button
            android:id="@+id/boutonSuivant"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Suivant"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6534D9"/>

    </LinearLayout>

    <!-- === Résultat final (masqué au départ) === -->
    <LinearLayout
        android:id="@+id/conteneurResultat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#F7F7FB"
        android:visibility="gone">

        <TextView
            android:id="@+id/texteScoreResultat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="#6534D9"
            android:textSize="44sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/texteMessageResultat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Résultat enregistré"
            android:textColor="#77758A"
            android:textSize="15sp"
            android:gravity="center"/>

        <Button
            android:id="@+id/boutonRetourListeQuiz"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Retour aux quiz"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6534D9"/>

    </LinearLayout>

</LinearLayout>
