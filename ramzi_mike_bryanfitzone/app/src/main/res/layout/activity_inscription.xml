<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="FitZone"
            android:textColor="#6534D9"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Créer un compte"
            android:textColor="#17152A"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rejoignez FitZone et commencez votre suivi"
            android:textColor="#77758A"
            android:textSize="14sp"/>

        <!-- Prénom -->

        <EditText
            android:id="@+id/editPrenomInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:hint="Prénom"
            android:inputType="textCapWords"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5"
            android:background="@drawable/bg_champ_recherche"/>

        <!-- Nom -->

        <EditText
            android:id="@+id/editNomInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Nom"
            android:inputType="textCapWords"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5"
            android:background="@drawable/bg_champ_recherche"/>

        <!-- Nom d'utilisateur -->

        <EditText
            android:id="@+id/editUsernameInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_champ_recherche"
            android:hint="Nom d'utilisateur"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5" />

        <!-- Courriel -->

        <EditText
            android:id="@+id/editEmailInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Courriel"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5"
            android:background="@drawable/bg_champ_recherche"/>

        <!-- Téléphone -->

        <EditText
            android:id="@+id/editTelephoneInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Téléphone"
            android:inputType="phone"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5"
            android:background="@drawable/bg_champ_recherche"/>

        <!-- Photo de profil (URL) -->

        <EditText
            android:id="@+id/editPhotoUrlInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="URL de la photo de profil (optionnel)"
            android:inputType="textUri"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5"
            android:background="@drawable/bg_champ_recherche"/>

        <!-- Mot de passe -->

        <EditText
            android:id="@+id/editPasswordInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Mot de passe"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5"
            android:background="@drawable/bg_champ_recherche"/>

        <!-- Confirmation -->

        <EditText
            android:id="@+id/editConfirmationPasswordInscription"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Confirmer le mot de passe"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="#17152A"
            android:textColorHint="#9997A5"
            android:background="@drawable/bg_champ_recherche"/>

        <Button
            android:id="@+id/boutonCreerCompte"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Créer mon compte"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#6534D9"/>

        <TextView
            android:id="@+id/boutonRetourConnexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:text="Déjà un compte ? Se connecter"
            android:textColor="#6534D9"
            android:textSize="14sp"/>

    </LinearLayout>

</ScrollView>
