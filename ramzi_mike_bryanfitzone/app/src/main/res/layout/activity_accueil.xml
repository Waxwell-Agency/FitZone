<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/texteBonjour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bonjour !"
            android:textColor="#17152A"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="FZ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_cercle_violet"/>

    </LinearLayout>

    <!-- Contenu -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Bannière résumé -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_banniere_violette">

                <TextView
                    android:id="@+id/texteResumeStatut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Suivez votre progression."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/texteNbAFaire"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="0\nÀ faire"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/bg_badge_blanc_transparent"/>

                    <TextView
                        android:id="@+id/texteNbEnRetard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="0\nEn retard"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/bg_badge_blanc_transparent"/>

                    <TextView
                        android:id="@+id/texteNbValidees"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="0\nValidées"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/bg_badge_blanc_transparent"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Mes programmes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:padding="16dp"
                android:background="@drawable/bg_carte">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mes programmes"
                        android:textColor="#17152A"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/texteNbProgrammes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 programme"
                        android:textColor="#77758A"
                        android:textSize="13sp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/boutonProgrammes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6534D9"/>

            </LinearLayout>

            <!-- Quiz disponibles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:background="@drawable/bg_carte">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quiz disponibles"
                        android:textColor="#17152A"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/texteNbQuiz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 quiz"
                        android:textColor="#77758A"
                        android:textSize="13sp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/boutonQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6534D9"/>

            </LinearLayout>

            <!-- Prochaines séances -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Prochaines séances"
                android:textColor="#17152A"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/containerSeances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/texteAucuneSeance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Aucune séance à venir."
                android:textColor="#77758A"
                android:textSize="14sp"
                android:visibility="gone"/>

            <!-- Annonces -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Annonces récentes"
                android:textColor="#17152A"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/containerAnnonces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/texteAucuneAnnonce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="Aucune annonce pour le moment."
                android:textColor="#77758A"
                android:textSize="14sp"
                android:visibility="gone"/>

        </LinearLayout>

    </ScrollView>

    <!-- Navigation inférieure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="5dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navAccueil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Accueil"
            android:textColor="#6534D9"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navProgrammes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣&#10;Programmes"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navSeances"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦&#10;Séances"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navQuiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="❓&#10;Quiz"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="○&#10;Profil"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

    </LinearLayout>

</LinearLayout>
