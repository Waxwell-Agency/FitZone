<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/boutonRetourProgramme"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#17152A"
            android:textSize="38sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Détails du programme"
            android:textColor="#17152A"
            android:textSize="21sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bannière du programme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:orientation="vertical"
                android:gravity="bottom"
                android:padding="22dp"
                android:background="@drawable/bg_banniere_violette">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:text="PROGRAMME ACTIF"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_blanc_transparent"/>

                <TextView
                    android:id="@+id/texteNomProgramme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Prise de masse"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/texteCodeProgramme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="FZ101 • Session été 2026"
                    android:textColor="#EFEAFF"
                    android:textSize="14sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Informations -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="17dp"
                    android:background="@drawable/bg_carte">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Marc Dubois"
                            android:textColor="#17152A"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Coach"
                            android:textColor="#77758A"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="42dp"
                        android:background="#E5E2EC"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 semaines"
                            android:textColor="#17152A"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Durée"
                            android:textColor="#77758A"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="42dp"
                        android:background="#E5E2EC"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75 %"
                            android:textColor="#6534D9"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Progression"
                            android:textColor="#77758A"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="À propos du programme"
                    android:textColor="#17152A"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/texteDescriptionProgramme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Ce programme est conçu pour développer votre masse musculaire, améliorer votre force et perfectionner votre technique grâce à des séances progressives."
                    android:textColor="#666477"
                    android:textSize="14sp"/>

                <!-- Prochaine séance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Prochaine séance"
                    android:textColor="#17152A"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/carteProchaineSeance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp"
                    android:background="@drawable/bg_carte">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="🏋"
                        android:textSize="24sp"
                        android:background="@drawable/bg_icone_violet_clair"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Séance Haut du corps"
                            android:textColor="#17152A"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mercredi 12 août • 10 h 30"
                            android:textColor="#77758A"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#6534D9"
                        android:textSize="30sp"/>

                </LinearLayout>

                <!-- Sections -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Contenu du programme"
                    android:textColor="#17152A"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/boutonVoirSeances"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:text="▦   Séances d’entraînement"
                    android:textAllCaps="false"
                    android:textColor="#17152A"
                    android:textSize="15sp"
                    android:backgroundTint="#FFFFFF"/>

                <Button
                    android:id="@+id/boutonVoirQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="9dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:text="?   Quiz de connaissances"
                    android:textAllCaps="false"
                    android:textColor="#17152A"
                    android:textSize="15sp"
                    android:backgroundTint="#FFFFFF"/>

                <Button
                    android:id="@+id/boutonVoirAnnonces"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="9dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:text="☷   Annonces du coach"
                    android:textAllCaps="false"
                    android:textColor="#17152A"
                    android:textSize="15sp"
                    android:backgroundTint="#FFFFFF"/>

                <Button
                    android:id="@+id/boutonVoirRessources"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="15dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:text="▤   Ressources"
                    android:textAllCaps="false"
                    android:textColor="#17152A"
                    android:textSize="15sp"
                    android:backgroundTint="#FFFFFF"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>