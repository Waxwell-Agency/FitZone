<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quiz"
            android:textColor="#17152A"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="FZ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_cercle_violet"/>

    </LinearLayout>

    <!-- Contenu -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Testez vos connaissances"
                android:textColor="#17152A"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Retrouvez les quiz de vos programmes."
                android:textColor="#77758A"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/texteNbQuizDisponibles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="0 quiz"
                android:textColor="#77758A"
                android:textSize="14sp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/texteAucunQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Aucun quiz disponible pour vos programmes."
                android:textColor="#77758A"
                android:textSize="14sp"
                android:visibility="gone"/>

        </LinearLayout>

    </ScrollView>

    <!-- Navigation inférieure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="5dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navAccueil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Accueil"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navProgrammes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣&#10;Programmes"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navSeances"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦&#10;Séances"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navQuiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="❓&#10;Quiz"
            android:textColor="#6534D9"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="○&#10;Profil"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

    </LinearLayout>

</LinearLayout>
