<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mes programmes"
            android:textColor="#17152A"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="FZ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_cercle_violet"/>

    </LinearLayout>

    <!-- Contenu -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programmes d’entraînement"
                android:textColor="#17152A"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Retrouvez les programmes auxquels vous êtes inscrit."
                android:textColor="#77758A"
                android:textSize="14sp"/>

            <!-- Recherche -->
            <EditText
                android:id="@+id/editRechercheProgramme"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_champ_recherche"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:hint="Rechercher un programme..."
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#17152A"
                android:textColorHint="#9997A5"/>

            <!-- Filtres -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/boutonTous"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Tous"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#6534D9"/>

                    <Button
                        android:id="@+id/boutonActifs"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Actifs"
                        android:textAllCaps="false"
                        android:textColor="#6534D9"
                        android:backgroundTint="#EDE7FF"/>

                    <Button
                        android:id="@+id/boutonTermines"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Terminés"
                        android:textAllCaps="false"
                        android:textColor="#6534D9"
                        android:backgroundTint="#EDE7FF"/>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Nombre de programmes -->
            <TextView
                android:id="@+id/texteNombreProgrammes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="0 programme"
                android:textColor="#77758A"
                android:textSize="14sp"/>

            <!-- Liste dynamique des programmes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProgrammes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>

    </ScrollView>

    <!-- Navigation inférieure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="5dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navAccueil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Accueil"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navProgrammes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣&#10;Programmes"
            android:textColor="#6534D9"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navSeances"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦&#10;Séances"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navQuiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="❓&#10;Quiz"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="○&#10;Profil"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

    </LinearLayout>

</LinearLayout>