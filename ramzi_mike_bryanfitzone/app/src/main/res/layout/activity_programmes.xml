<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mes programmes"
            android:textColor="#17152A"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="FZ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_cercle_violet"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programmes d’entraînement"
                android:textColor="#17152A"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Retrouvez les programmes auxquels vous êtes inscrit."
                android:textColor="#77758A"
                android:textSize="14sp"/>

            <!-- Recherche -->
            <EditText
                android:id="@+id/editRechercheProgramme"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_champ_recherche"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:hint="Rechercher un programme..."
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#17152A"
                android:textColorHint="#9997A5"/>

            <!-- Filtres -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/boutonTous"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Tous"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#6534D9"/>

                    <Button
                        android:id="@+id/boutonActifs"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Actifs"
                        android:textAllCaps="false"
                        android:textColor="#6534D9"
                        android:backgroundTint="#EDE7FF"/>

                    <Button
                        android:id="@+id/boutonTermines"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Terminés"
                        android:textAllCaps="false"
                        android:textColor="#6534D9"
                        android:backgroundTint="#EDE7FF"/>

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/texteNombreProgrammes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="3 programmes"
                android:textColor="#77758A"
                android:textSize="14sp"/>

            <!-- Programme 1 -->
            <LinearLayout
                android:id="@+id/carteProgrammeMusculation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_carte">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="🏋"
                        android:textSize="27sp"
                        android:background="@drawable/bg_icone_violet_clair"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prise de masse"
                            android:textColor="#17152A"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Code : FZ101"
                            android:textColor="#77758A"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Coach : Marc Dubois"
                            android:textColor="#77758A"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="Actif"
                        android:textColor="#158A62"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_statut_actif"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Progression"
                    android:textColor="#77758A"
                    android:textSize="13sp"/>

                <ProgressBar
                    android:id="@+id/progressionMusculation"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:progress="75"
                    android:progressTint="#6534D9"
                    android:progressBackgroundTint="#E5E2EC"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:text="75 %"
                    android:textColor="#6534D9"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/boutonVoirProgrammeMusculation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Voir le programme"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#6534D9"/>

            </LinearLayout>

            <!-- Programme 2 -->
            <LinearLayout
                android:id="@+id/carteProgrammePertePoids"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_carte">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="🏃"
                        android:textSize="27sp"
                        android:background="@drawable/bg_icone_violet_clair"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perte de poids"
                            android:textColor="#17152A"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Code : FZ204"
                            android:textColor="#77758A"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Coach : Sarah Martin"
                            android:textColor="#77758A"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="Actif"
                        android:textColor="#158A62"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_statut_actif"/>

                </LinearLayout>

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="18dp"
                    android:max="100"
                    android:progress="40"
                    android:progressTint="#6534D9"
                    android:progressBackgroundTint="#E5E2EC"
                    style="?android:attr/progressBarStyleHorizontal"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:text="40 %"
                    android:textColor="#6534D9"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/boutonVoirProgrammePertePoids"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Voir le programme"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#6534D9"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Navigation inférieure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="5dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navAccueil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Accueil"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navProgrammes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣&#10;Programmes"
            android:textColor="#6534D9"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navSeances"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦&#10;Séances"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navQuiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="❓&#10;Quiz"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="○&#10;Profil"
            android:textColor="#8B8997"
            android:textSize="12sp"/>

    </LinearLayout>

</LinearLayout>